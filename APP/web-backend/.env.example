# Independent Web backend; do not reuse the mini-program token or credentials.
PINDOU_HOST=127.0.0.1
PINDOU_PORT=8001
PINDOU_CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# Required: replace with a random token containing at least 32 characters.
# Used as Authorization: Bearer <token>; no registration or login endpoint yet.
PINDOU_WEB_ACCESS_TOKEN=
# local: single-process development only; cloudbase: persistent cloud quota.
PINDOU_QUOTA_BACKEND=local
PINDOU_RATE_MAX_CONVERSIONS=20
# Leave blank to use this backend's own runtime; cloud uses /tmp/pindou-web-runtime.
PINDOU_RUNTIME_DIR=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
PINDOU_WEB_I2I_MODEL=qwen-image-3.0-pro
PINDOU_I2I_TIMEOUT=50
# CloudBase quota mode only; use dedicated Web environment/credentials/collection.
CLOUDBASE_ENV_ID=
PINDOU_TCB_SECRET_ID=
PINDOU_TCB_SECRET_KEY=
PINDOU_TCB_SESSION_TOKEN=
PINDOU_WEB_QUOTA_COLLECTION=pindou_web_quota

PINDOU_TCB_REGION=ap-shanghai


# Web image-edit provider (display name does not change the protocol)
PINDOU_AI_PROVIDER=阿里云百炼
PINDOU_AI_PROTOCOL=dashscope
